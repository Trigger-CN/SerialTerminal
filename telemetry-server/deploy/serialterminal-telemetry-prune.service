[Unit]
Description=Prune expired SerialTerminal activity rows
After=postgresql.service

[Service]
Type=oneshot
User=serialterminal-telemetry
Group=serialterminal-telemetry
WorkingDirectory=/home/ubuntu/ws/SerialTerminal/telemetry-server
EnvironmentFile=/etc/serialterminal-telemetry.env
ExecStart=/home/ubuntu/ws/SerialTerminalTelemetry/runtime/bin/node scripts/prune-activity.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
